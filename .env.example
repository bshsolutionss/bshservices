# ==========================================
# CANONICAL SITE URL
# ==========================================
# The single source of truth for every absolute URL the app emits (see
# lib/site.ts) — metadataBase, sitemap.xml, robots.txt, JSON-LD, emails.
# No trailing slash. Change this one value to migrate domains again.
NEXT_PUBLIC_SITE_URL=https://bshsolutions.net

# ==========================================
# RESEND EMAIL SERVICE CONFIGURATION
# ==========================================
RESEND_API_KEY=your_resend_api_key_here
RESEND_API=your_resend_api_key_here

# ==========================================
# SUPABASE CLIENT-SIDE CONFIGURATION (PUBLIC)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# ==========================================
# SUPABASE SERVER-SIDE CONFIGURATION (PRIVATE)
# ==========================================
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWKS_URL=https://your-supabase-project.supabase.co/auth/v1/.well-known/jwks.json

# ==========================================
# FOLLOW-UP CRON PROTECTION
# ==========================================
# Vercel automatically sends `Authorization: Bearer $CRON_SECRET` on
# scheduled invocations of /api/cron/follow-ups (see vercel.json). Set this
# to a long random string in your Vercel project's env vars. A `?secret=`
# query param with the same value also works, for manual/local testing.
CRON_SECRET=your_random_cron_secret_here

# ==========================================
# WEB PUSH (VAPID) — admin panel "new lead/booking" notifications
# ==========================================
# Generate a real pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:you@example.com

# ==========================================
# WORDPRESS & WOOCOMMERCE API CONFIGURATION
# ==========================================
WORDPRESS_URL=https://your-wordpress-site.com
WORDPRESS_API_URL=https://your-wordpress-site.com/wp-json/wp/v2
WOOCOMMERCE_URL=https://your-wordpress-site.com
WOOCOMMERCE_CONSUMER_KEY=ck_your_woocommerce_consumer_key_here
WOOCOMMERCE_CONSUMER_SECRET=cs_your_woocommerce_consumer_secret_here

