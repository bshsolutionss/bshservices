# ==========================================
# RESEND EMAIL SERVICE CONFIGURATION
# ==========================================
RESEND_API_KEY=your_resend_api_key_here
RESEND_API=your_resend_api_key_here

# ==========================================
# SUPABASE CLIENT-SIDE CONFIGURATION (PUBLIC)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# ==========================================
# SUPABASE SERVER-SIDE CONFIGURATION (PRIVATE)
# ==========================================
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWKS_URL=https://your-supabase-project.supabase.co/auth/v1/.well-known/jwks.json

# ==========================================
# FOLLOW-UP CRON PROTECTION
# ==========================================
# Vercel automatically sends `Authorization: Bearer $CRON_SECRET` on
# scheduled invocations of /api/cron/follow-ups (see vercel.json). Set this
# to a long random string in your Vercel project's env vars. A `?secret=`
# query param with the same value also works, for manual/local testing.
CRON_SECRET=your_random_cron_secret_here
